rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['betul-donmez@hotmail.com']; }
    function isTeacher() { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email))); }
    function isStudent() { return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/students/$(request.auth.uid)).data; }

    // Öğretmenler: sadece yönetici ekler; öğretmen kendi kaydını okuyabilir
    match /teachers/{email} {
      allow read: if isTeacher() || (signedIn() && request.auth.token.email == email);
      allow write: if isAdmin();
    }
    // Site ayarları: herkes okuyabilir (giriş ekranı için), sadece öğretmen değiştirir
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Öğrenci kayıtları: öğrenci sadece kendini görür
    match /students/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow write: if isTeacher();
    }
    // Ödevler: öğrenci sadece kendi sınıf düzeyindeki yayındaki ödevleri görür
    match /assignments/{id} {
      allow read: if isTeacher() || (isStudent() && resource.data.published == true && resource.data.grade == me().grade);
      allow write: if isTeacher();
    }
    // Cevaplar: öğrenci kendi cevabını yazar, öğretmen puanını değiştiremez
    match /submissions/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isTeacher();
      allow create, update: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.assignmentId + '_' + request.auth.uid
        && request.resource.data.get('writingPoints', null) == null;
    }
    // Geri bildirimler: öğrenci sadece kendisininkini okur
    match /feedback/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isTeacher();
    }
    // Avatar: öğrenci kendi avatarını kaydeder
    match /profiles/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow write: if isTeacher() || (isStudent() && request.auth.uid == uid && request.resource.data.uid == uid);
    }
    // Sınıf içi artı/eksi puanlar
    match /points/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isTeacher();
    }
    // Şube yarışı toplamları
    match /classStats/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    // Kelime setleri
    match /wordsets/{id} {
      allow read: if isTeacher() || (isStudent() && resource.data.published == true && resource.data.grade == me().grade);
      allow write: if isTeacher();
    }
    // Kelime oyunu ilerlemesi: öğrenci kendi kaydını yazar
    match /practice/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow write: if isTeacher() || (isStudent() && request.auth.uid == uid && request.resource.data.uid == uid);
    }
    // Haftanın yıldızları: her öğrencinin haftalık XP kaydı
    match /weekly/{id} {
      allow read: if signedIn();
      allow write: if isTeacher() || (isStudent() && request.resource.data.uid == request.auth.uid && id == string(request.resource.data.grade) + request.resource.data.section + '_' + request.auth.uid);
    }
  }
}
